# Server
HOST=0.0.0.0
PORT=8080
GRPC_PORT=50051

# PostgreSQL (only required when building with the "postgres" feature)
DATABASE_URL=postgres://user:password@localhost:5432/boilerplate

# Redis (refresh token storage)
REDIS_URL=redis://localhost:6379

# Authentication — JWT signed with EdDSA (Ed25519). Generate a key pair with:
#   openssl genpkey -algorithm ed25519 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./jwt_private.pem
JWT_PUBLIC_KEY_PATH=./jwt_public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Security — comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# Observability
RUST_LOG=info
OTLP_ENDPOINT=http://localhost:4317
