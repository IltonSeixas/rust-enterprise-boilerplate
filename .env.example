# Server
HOST=0.0.0.0
PORT=8080
GRPC_PORT=50051

# PostgreSQL (only required when building with the "postgres" feature)
DATABASE_URL=postgres://user:password@localhost:5432/boilerplate

# Redis (refresh token storage)
REDIS_URL=redis://localhost:6379

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-minimum-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Security — comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# Observability
RUST_LOG=info
OTLP_ENDPOINT=http://localhost:4317
